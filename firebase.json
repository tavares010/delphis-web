{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.firebase/**",
      "**/node_modules/**",
      "**/*.py",
      "**/*.apk",
      "**/*.ipa",
      "web_export/PROMPT.md",
      "web_export/README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      }
    ]
  }
}
